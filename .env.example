# Shared Postgres (same DB as jojjy-gallery-app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Direct (non-pooled) URL for Prisma CLI / migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Public gallery base URL (browser-exposed). Powers "View public page" links
# in the CRM. The gallery is a separate deployment; leave unset to hide them.
NEXT_PUBLIC_GALLERY_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Cloudinary (required for artwork/event/cover image uploads and track audio)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paystack (server-side only). Required to submit/approve refunds from the CRM.
# Never expose this to the browser. Same account as jojjy-gallery-app.
PAYSTACK_SECRET_KEY=""

# OpenUI assistant model provider (server-side only; deployment prerequisite).
# Leave unset to run the assistant in deterministic routing mode. Set the base
# URL and model name (plus API key for hosted providers) to enable the model.
# Never commit real keys.
# DeepInfra-hosted DeepSeek V4.1 Flash: enter your DeepInfra API key when ready.
# Base URL only; the CRM appends /chat/completions.
OPENUI_MODEL_BASE_URL="https://api.deepinfra.com/v1/openai"
OPENUI_MODEL_API_KEY=""
OPENUI_MODEL_NAME="deepseek-ai/DeepSeek-V4.1-Flash"
